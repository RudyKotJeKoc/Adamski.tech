  "fonts": {
    "heading": {
      "family": "Chakra Petch",
      "fallbacks": ["Inter Variable", "ui-sans-serif", "system-ui"],
      "weight": ["500", "600", "700"]
    },
    "body": {
      "family": "Inter Variable",
      "fallbacks": ["Inter", "ui-sans-serif", "system-ui"],
      "weight": ["400", "500", "600"]
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallbacks": ["ui-monospace", "monospace"]
    }
  },
  "shadows": {
    "card": "inset 0 1px 0 rgba(228,231,220,0.05), 0 18px 40px -22px rgba(0,0,0,0.7)",
    "glow_led": "0 0 0 1px rgba(217,164,65,0.4), 0 0 28px rgba(217,164,65,0.2)"
  },
  "gradients": {
    "hero_bg": "radial-gradient(120% 90% at 78% 18%, rgba(85,93,64,0.42) 0%, rgba(23,27,24,0) 58%), linear-gradient(180deg, #1b201c 0%, #141815 100%)",
    "button": "linear-gradient(90deg, #e4e7dc 0%, #c3b99b 55%, #d9a441 100%)",
    "card_hover": "radial-gradient(circle at 20% 20%, rgba(217,164,65,0.12), transparent 45%)"
  },
  "motion": {
    "durations": {
      "fast": "150ms",
      "base": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "in_out": "cubic-bezier(0.4,0,0.2,1)",
      "out": "cubic-bezier(0,0,0.2,1)"
    },
    "reveal": {
      "fade_in": {
        "opacity": [0, 1],
        "translateY": ["8px", "0px"]
      }
    }
  },
  "icon_style": {
    "set": "lucide",
    "stroke_width": 1.5,
    "corner_style": "square"
  },
  "radii": {
    "card": "4px",
    "button": "2px",
    "chip": "2px"
  }
}
